    "research:phase27-d-archetype-conditional-residual-decomposition": "node scripts/analyze-phase27-d-archetype-conditional-residual-decomposition.mjs",
    "research:phase28-d-archetype-conditional-validation": "node scripts/analyze-phase28-d-archetype-conditional-validation.mjs",
