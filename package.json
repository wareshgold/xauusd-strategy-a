{
  "name": "xauusd-strategy-a",
  "version": "0.1.0",
  "private": true,
  "description": "Deterministic XAUUSD price-action signal system based on SP2L (Strategy A).",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "download:data": "node scripts/download-xauusd.mjs",
    "audit:data": "node scripts/audit-dataset.mjs",
    "backtest:baseline": "tsc -p tsconfig.backtest.json && node dist/scripts/run-baseline-backtest.js",
    "research:tp1": "node scripts/analyze-tp1-attainment-forensics.mjs",
    "research:tp1-management": "node scripts/analyze-tp1-management-scenarios-global-holdout.mjs",
    "research:tp1-rolling": "node scripts/analyze-tp1-full-exit-rolling-robustness.mjs",
    "research:base-components": "node scripts/analyze-base-component-contribution-global-holdout.mjs",
    "research:base-funnel": "node scripts/analyze-base-stage-funnel-forensics.mjs",
    "research:trigger-funnel": "node scripts/analyze-trigger-funnel-forensics.mjs",
    "research:trigger-latency": "node scripts/analyze-trigger-latency-global-holdout.mjs",
    "research:opportunity-window": "node scripts/analyze-opportunity-window-global-holdout.mjs",
    "research:entry-geometry-single-factor": "node scripts/analyze-entry-geometry-single-factor-oos.mjs",
    "research:structural-chain-quality": "node scripts/analyze-structural-chain-quality-global-holdout.mjs",
    "research:temporal-regime-stability": "node scripts/analyze-temporal-regime-stability.mjs",
    "research:strong-weak-attribution": "node scripts/analyze-strong-weak-window-attribution.mjs",
    "research:direction-session-rolling": "node scripts/analyze-direction-session-rolling-robustness.mjs",
    "research:fresh-holdout-late-ny": "node scripts/analyze-fresh-holdout-late-ny.mjs",
    "research:volatility-hypothesis-holdout": "tsc -p tsconfig.backtest.json && node dist/scripts/analyze-volatility-hypothesis-holdout.js",
    "research:baseline-forensics-holdout": "tsc -p tsconfig.backtest.json && node dist/scripts/analyze-baseline-forensics-holdout.js",
    "research:baseline-attribution-v2-holdout": "tsc -p tsconfig.backtest.json && node dist/scripts/analyze-baseline-attribution-v2-holdout.js"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "latest",
    "eslint": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
}
