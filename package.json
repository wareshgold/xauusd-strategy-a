{
  "name": "xauusd-strategy-a",
  "version": "0.1.0",
  "private": true,
  "description": "Deterministic XAUUSD price-action signal system based on SP2L (Strategy A).",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "test": "vitest run",
    "test:sp2l-v2": "vitest run tests/sp2l-v2-semantic-state.test.ts",
    "test:sp2l-g1": "vitest run tests/sp2l-v2-structural-reference.test.ts",
    "test:sp2l-g2": "vitest run tests/sp2l-v2-pending-limit.test.ts",
    "test:sp2l-g3": "vitest run tests/sp2l-v2-structural-stop.test.ts",
    "test:sp2l-g4g5": "vitest run tests/sp2l-v2-g4g5-discriminating-fixtures.test.ts tests/sp2l-v2-g4g5-source-extraction.test.ts",
    "lint": "eslint .",
    "research:phase42-full-history-expansion": "node scripts/research-phase42-full-history-expansion.mjs",
    "research:phase43-contribution-audit": "node scripts/research-phase43-contribution-audit.mjs",
    "research:phase44-baseline-counterfactual-audit": "node scripts/research-phase44-baseline-counterfactual-audit.mjs",
    "research:phase45-fresh-holdout-audit": "node scripts/research-phase45-fresh-holdout-audit.mjs",
    "research:phase46-extended-fresh-holdout-audit": "node scripts/research-phase46-extended-fresh-holdout-audit.mjs"
  },
  "devDependencies": {
    "@types/node": "latest",
    "eslint": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
}
