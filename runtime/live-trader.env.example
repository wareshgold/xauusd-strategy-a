# MT5
TRADING_SYMBOL=XAUUSD.ecn
MT5_MAGIC=26091901
MT5_DEVIATION_POINTS=30
POLL_SECONDS=2
SIGNAL_FILE=runtime/approved_signal.json
MAX_OPEN_POSITIONS=1

# Safety: keep false until the full execution path has been tested.
LIVE_TRADING_ENABLE=false

# Second key of the real-execution double gate. Real order_send happens ONLY
# when BOTH LIVE_TRADING_ENABLE=true AND ALLOW_REAL_EXECUTION=true. One
# forgotten/missing flag can never reach the broker.
ALLOW_REAL_EXECUTION=false

# Telegram Bot API
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Reporting (research reporting only; sends no orders, creates no signals)
# Session timezone per docs/research/SESSION_TIMEZONE_CORRECTION_2026-09-05.md.
# Must be an IANA zone name; never a fixed UTC offset.
REPORT_SESSION_TIMEZONE=America/New_York
# Explicit NY close time (HH:MM in the session timezone). Configuration input,
# not an inferred broker conversion. Verify against broker session metadata.
REPORT_NY_CLOSE_HHMM=17:00
# Where the close boundary comes from. Any UNRESOLVED_* value blocks scheduled
# reports instead of guessing.
REPORT_SCHEDULE_BASIS=EXPLICIT_NY_CLOSE_1700_ET
# XAUUSD price units per pip. Supplied explicitly, never inferred
# (see scripts/calculate-sp2l-pl-pip-accounting.py). Empty = pips reported n/a.
REPORT_PIP_SIZE=
# Echoed verbatim into report System section. Do not change without the
# frozen-geometry gate.
SP2L_GEOMETRY_STATUS=UNRESOLVED_FROZEN_GEOMETRY_GATE
